{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MalwareScanning": {
    "Enabled": false
  },
  "Ocr": {
    "Enabled": false,
    "Provider": "Disabled",
    "Language": "en",
    "MaxAttempts": 3,
    "TimeoutSeconds": 30,
    "MaxElements": 10000,
    "MaxRecognizedCharacters": 1000000
  },
  "DocumentBoundary": {
    "Mode": "OpenCvOnly",
    "RolloutPercentage": 0
  },
  "DocumentImport": {
    "MaxUploadBytes": 26214400,
    "MaxPagesPerImport": 50,
    "MaxPagesPerDocument": 50,
    "MaxDecodedPixels": 250000000,
    "MaxRenderedBytes": 524288000,
    "InspectTimeoutSeconds": 15,
    "PageRenderTimeoutSeconds": 45,
    "MaxAttempts": 6
  },
  "DocumentExport": {
    "MaxOutputBytes": 104857600,
    "RetentionDays": 7
  },
  "Pages": {
    "SoftDeleteRetentionDays": 30
  }
}
